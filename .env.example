# =====================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO LAB (K4-DAY26)
# =====================================================================

# ---------------------------------------------------------------------
# 1. Google Gemini API Key
# Dùng cho: 01-function-calling và 04-lab/mcp-client
# Lấy API key miễn phí tại: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# 2. WeatherAPI Key
# Dùng cho: 04-lab/mcp-server
# Lấy API key miễn phí tại: https://www.weatherapi.com
# ---------------------------------------------------------------------
WEATHERAPI_KEY=your_weatherapi_key_here

# ---------------------------------------------------------------------
# 3. MCP Server Configuration (04-lab/mcp-server)
# Cổng chạy FastMCP Server (mặc định: 8085)
# ---------------------------------------------------------------------
PORT=8085

# ---------------------------------------------------------------------
# 4. MCP Client Configuration (04-lab/mcp-client)
# Địa chỉ Streamable HTTP endpoint kết nối tới MCP Server
# - Khi chạy local: http://localhost:8085/mcp
# - Khi deploy Cloud Run: https://<service-name>.run.app/mcp
# ---------------------------------------------------------------------
MCP_SERVER_URL=http://localhost:8085/mcp

# ---------------------------------------------------------------------
# 5. Production Demo Authentication (03-production)
# Token mẫu cho xác thực Bearer token (auth_server.py / auth_client.py)
# ---------------------------------------------------------------------
MCP_AUTH_TOKEN=dev-token-abc123
